# Copy to .env.local and fill in. Only NEXT_PUBLIC_SITE_URL is read by the app.

# Origin of the deployed site, no trailing slash. Canonical URLs, Open Graph
# tags, sitemap.xml and feed.xml are all built from it.
#
# Optional: when unset, content/site.ts falls back to https://asimzz.github.io.
# In CI this does NOT come from a file -- it comes from the SITE_URL repository
# variable (Settings -> Secrets and variables -> Actions -> Variables).
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Notion. Read by `pnpm content:sync` ONLY.
#
# `pnpm dev` and `pnpm build` never touch Notion -- they read the committed
# files in content/ -- so a fresh clone needs none of this to run the site.
#
# NEVER prefix any of these with NEXT_PUBLIC_. That is what inlines a value
# into the client bundle, where anyone can read it.
# ---------------------------------------------------------------------------

# Internal integration secret from https://www.notion.so/my-integrations
# In CI this is an Actions *secret*, not a variable.
NOTION_TOKEN=ntn_xxx

# Each database's id, or just paste the URL of the database page -- the sync
# pulls the id out of either. In CI these are Actions *variables*.
NOTION_DB_PROFILE=
NOTION_DB_SOCIALS=
NOTION_DB_NEWS=
NOTION_DB_PUBLICATIONS=
NOTION_DB_PROJECTS=
NOTION_DB_POSTS=
