# Copy to .env.local and fill in. Only NEXT_PUBLIC_SITE_URL is read by the app.

# Origin of the deployed site, no trailing slash. Canonical URLs, Open Graph
# tags, sitemap.xml and feed.xml are all built from it.
#
# Optional: when unset, content/site.ts falls back to https://asimzz.github.io.
# In CI this does NOT come from a file -- it comes from the SITE_URL repository
# variable (Settings -> Secrets and variables -> Actions -> Variables).
NEXT_PUBLIC_SITE_URL=https://example.com
